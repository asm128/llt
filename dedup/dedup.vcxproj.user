    <LocalDebuggerCommandArgumentsHistory>-- e:\music e:\musica |-- e:\music e:\musica "E:\Musica\Cypress Hill\" "E:\Musica\Cypress Hill\2000 - Skull &amp; Bones - Bones Disc"|-- e:\music e:\musica "E:\Musica\Cypress Hill" "E:\Musica\Cypress Hill\2000 - Skull &amp; Bones - Bones Disc"|-- E:\music E:\Musica "E:\Musica\Cypress Hill" "E:\Musica\Cypress Hill\2000 - Skull &amp; Bones - Bones Disc"|</LocalDebuggerCommandArgumentsHistory>
