    <LocalDebuggerCommandArguments>-- e:\music e:\musica </LocalDebuggerCommandArguments>
    <LocalDebuggerCommandArgumentsHistory>-- e:\music e:\musica |</LocalDebuggerCommandArgumentsHistory>
